#!/bin/bash
# sagemic-helper - the ONLY root-level actions the SageMic station programs may
# perform (software and model updates from the SageMic hub).
# Installed as /usr/local/sbin/sagemic-helper (root-owned) and allowed in
# /etc/sudoers.d/sagemic. Every argument is checked against a fixed list.
set -euo pipefail

die() { echo "sagemic-helper: $*" >&2; exit 2; }
check_install_args() {   # station folder, config file (run-installer, update-guard)
  path_re='^/home/[a-z_][a-z0-9_-]*(/[A-Za-z0-9._-]+)+$'
  [[ "$1" =~ $path_re && "$1" != *..* && -d "$1" ]] || die "folder not allowed: $1"
  [[ "$2" =~ $path_re && "$2" != *..* && -f "$2" ]] || die "config not allowed: $2"
  [[ -f "$1/install_agent.sh" ]] || die "no install_agent.sh in $1"
  owner=$(stat -c %U "$1")
  [[ "$owner" != root ]] || die "folder must belong to the SageMic user"
}
GUARD=sagemic-update-guard     # transient timer + service, armed by run-installer

action="${1:-}"
case "$action" in
  restart)
    unit="${2:-}"
    case "$unit" in
      sagemic_local.service) systemctl restart "$unit" ;;   # sagemic_update.py: new model
      *) die "unit not allowed: $unit" ;;
    esac ;;
  run-installer)
    # Used by sagemic_update.py. Runs install_agent.sh in its own systemd
    # unit, so it finishes even when it restarts the update service itself.
    # Exit code -> /run/sagemic_install.rc, output -> /run/sagemic_install.log (RAM).
    # Also (re)arms the update guard: update-guard runs 30 min after this.
    dir="${2:-}"; cfg="${3:-}"
    check_install_args "$dir" "$cfg"
    systemctl stop 'sagemic-install-*.service' 2>/dev/null || true
    rm -f /run/sagemic_install.rc
    systemctl stop "$GUARD.timer" 2>/dev/null || true
    systemctl reset-failed "$GUARD.timer" "$GUARD.service" 2>/dev/null || true
    systemd-run --quiet --on-active=30min --unit="$GUARD" \
      /usr/local/sbin/sagemic-helper update-guard "$dir" "$cfg" >/dev/null 2>&1 || \
      logger -t sagemic-update-guard "could not arm the update guard (the update goes on without it)"
    systemd-run --quiet --collect --unit="sagemic-install-$(date +%s)" --setenv=SUDO_USER="$owner" \
      /bin/bash -c 'cd "$1" && bash ./install_agent.sh "$2" > /run/sagemic_install.log 2>&1; echo $? > /run/sagemic_install.rc' \
      sagemic-install "$dir" "$cfg" ;;
  update-guard)
    # Run as root by the timer run-installer arms (30 min after an install or
    # rollback started). If update_state.json still shows an update in progress
    # (the updater hung or keeps crashing), stop the updater, copy that update's
    # backup (~/sagemic_backup/<date-time>/, laid out as in the sagemic folder)
    # back, mark the update failed and rerun install_agent.sh.
    # Log: journalctl -t sagemic-update-guard
    dir="${2:-}"; cfg="${3:-}"
    check_install_args "$dir" "$cfg"
    log() { logger -t sagemic-update-guard -- "$*"; echo "$*"; }
    state="$dir/update_state.json"
    { read -r phase; read -r backup; } < <(python3 -c '
import json, sys
try:
    s = json.load(open(sys.argv[1]))
except Exception:
    s = {}
s = s if isinstance(s, dict) else {}
print(s.get("phase") or "idle"); print(s.get("backup") or "")' "$state")
    phase=${phase//[^a-z_]/}; backup=${backup//[$'\r\n']/}
    if [[ "$phase" == idle ]]; then log "no update in progress - nothing to do"; exit 0; fi
    home=$(getent passwd "$owner" | cut -d: -f6)
    if [[ ! "$backup" =~ ^"$home"/sagemic_backup/[0-9]{8}-[0-9]{6}$ || ! -d "$backup" || -L "$backup" ]]; then
      backup=$(find "$home/sagemic_backup" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended \
               -regex '.*/[0-9]{8}-[0-9]{6}' 2>/dev/null | sort | tail -1 || true)
    fi
    [[ -n "$backup" ]] || { log "update still $phase but no backup in $home/sagemic_backup - left as it is"; exit 1; }
    log "update still $phase after 30 min - restoring $backup into $dir"
    systemctl stop sagemic_update.service 'sagemic-install-*.service' 2>/dev/null || true
    group=$(id -gn "$owner")
    n=0
    # the backup is laid out as in the sagemic folder: station/<file>, <file>
    top="$(dirname "$dir")"
    rel_re='^([A-Za-z0-9_][A-Za-z0-9_.-]*/)?(sagemic-helper|[A-Za-z0-9_][A-Za-z0-9_.-]*\.(py|sh|txt|md|json))$'
    while IFS= read -r -d '' f; do
      rel="${f#"$backup"/}"; name=$(basename "$f")
      [[ "$rel" =~ $rel_re && -f "$f" && ! -L "$f" && -d "$(dirname "$top/$rel")" ]] || continue
      mode=644; [[ "$name" == sagemic-helper || "$name" == *.sh ]] && mode=755
      install -o "$owner" -g "$group" -m "$mode" "$f" "$top/$rel" && n=$((n + 1))
    done < <(find "$backup" -mindepth 1 -maxdepth 2 -type f -print0)
    python3 -c '
import json, os, sys, time
path, backup, phase = sys.argv[1:4]
try:
    s = json.load(open(path))
except Exception:
    s = {}
s = s if isinstance(s, dict) else {}
s["installed"] = s.get("previous")
s["phase"] = "idle"
s["last_result"] = {"id": s.get("id", ""), "ok": False, "time": int(time.time()),
                    "message": "update guard: still " + phase + " after 30 min - restored " + backup}
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(s, f, indent=1)
os.replace(tmp, path)' "$state" "$backup" "$phase" || log "could not update $state"
    chown "$owner:$group" "$state" 2>/dev/null || true
    log "restored $n file(s) - running install_agent.sh"
    rc=0
    (cd "$dir" && SUDO_USER="$owner" bash ./install_agent.sh "$cfg" > /run/sagemic_install.log 2>&1) || rc=$?
    if (( rc == 0 )); then
      log "install_agent.sh finished - the previous software is back (log: /run/sagemic_install.log)"
    else
      log "install_agent.sh FAILED (exit $rc) - see /run/sagemic_install.log; connect over SSH"; exit 1
    fi ;;
  update-guard-stop)
    # Used by sagemic_update.py when an update (or its rollback) has finished.
    systemctl stop "$GUARD.timer" 2>/dev/null || true ;;
  *) die "usage: restart sagemic_local.service | run-installer | update-guard | update-guard-stop" ;;
esac
